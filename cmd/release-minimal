#!/bin/bash

# exit on error
set -euo pipefail

# determine OS and architecture
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
ARCH=$(uname -m)

# CI only publishes macos-arm64 and linux-musl (x86_64) archives
if [[ "$OS" == "darwin" && ("$ARCH" == "arm64" || "$ARCH" == "aarch64") ]]; then
    RELEASE_SUFFIX="macos-arm64"
elif [[ "$OS" == "linux" && "$ARCH" == "x86_64" ]]; then
    RELEASE_SUFFIX="linux-musl"
else
    echo "error: no published cmd release for ${OS}/${ARCH}; build from source with ./release"
    exit 1
fi

CMD_PATH="$HOME/.local/bin/cmd"

echo "minimal mode: downloading cmd binary from GitHub releases..."

REPO_OWNER="praveenperera"
REPO_NAME="dotfiles"

LATEST_RELEASE_URL="https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/releases/latest"

# fetch a url to stdout, failing on http errors
fetch() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$1"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO- "$1"
    else
        echo "error: neither curl nor wget is available" >&2
        return 1
    fi
}

# download a url to a file, failing on http errors
download() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL -o "$2" "$1"
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O "$2" "$1"
    else
        echo "error: neither curl nor wget is available" >&2
        return 1
    fi
}

# get latest release tag
LATEST_RELEASE_JSON=$(fetch "$LATEST_RELEASE_URL") || {
    echo "error: could not fetch latest release info from $LATEST_RELEASE_URL"
    exit 1
}

LATEST_TAG=$(printf '%s\n' "$LATEST_RELEASE_JSON" | sed -nE 's/.*"tag_name": *"([^"]+)".*/\1/p' | head -n 1)

if [[ -z "$LATEST_TAG" ]]; then
    echo "error: could not parse latest release tag"
    exit 1
fi

echo "downloading cmd binary version $LATEST_TAG..."

# construct download URL
ASSET_NAME="cmd-${LATEST_TAG}-${RELEASE_SUFFIX}.tar.gz"
DOWNLOAD_URL="https://github.com/${REPO_OWNER}/${REPO_NAME}/releases/download/${LATEST_TAG}/${ASSET_NAME}"

# download and extract into a temp dir so a failure never touches the installed binary
TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

download "$DOWNLOAD_URL" "$TMP_DIR/$ASSET_NAME" || {
    echo "error: failed to download $DOWNLOAD_URL"
    exit 1
}

tar -xzf "$TMP_DIR/$ASSET_NAME" -C "$TMP_DIR"

if [[ ! -f "$TMP_DIR/cmd" ]]; then
    echo "error: $ASSET_NAME did not contain a cmd binary"
    exit 1
fi

chmod +x "$TMP_DIR/cmd"

if [[ ! -x "$TMP_DIR/cmd" ]]; then
    echo "error: extracted cmd binary is not executable"
    exit 1
fi

# only now replace the installed binary
mkdir -p "$HOME/.local/bin"
mv -f "$TMP_DIR/cmd" "$CMD_PATH"
"$CMD_PATH" release --link-installed

echo "cmd binary installed successfully at $CMD_PATH"
