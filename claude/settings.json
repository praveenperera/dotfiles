{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingMaxDescChars": 500,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SHELL": "bash",
    "SECURITY_REVIEW_MODEL": "claude-sonnet-5-5",
    "SG_AGENTIC_MODEL": "claude-sonnet-5-5",
    "ENABLE_STOP_REVIEW": "0",
    "ENABLE_CODE_SECURITY_REVIEW": "0"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read(~/code/**)",
      "Bash(xcodebuild:*)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:docs.rs)",
      "WebSearch",
      "Skill(spec)",
      "Skill(pr-review-toolkit)",
      "Skill(btx:*)",
      "Skill(feature-dev:feature-dev)",
      "Skill(pr-review-toolkit:review-pr)",
      "Skill(code-review:code-review)",
      "Skill(commit-commands:commit-push-pr)",
      "Skill(commit-commands:clean_gone)",
      "Skill(commit-commands:commit)",
      "Skill(frontend-design:frontend-design)",
      "Bash(gh pr list)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr comments:*)",
      "Bash(gh issue view:*)",
      "Bash(gh api:*)",
      "Bash(gh project list)",
      "Bash(awk:*)",
      "Skill(review-fix-loop)",
      "Bash(tee:*)",
      "Bash(jj:*)",
      "Bash(find:*)",
      "Bash(pr:*)",
      "Bash(cargo:*)",
      "Bash(just:*)",
      "WebFetch(domain:*)",
      "mcp__pencil"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "keybindings-help": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "init": "user-invocable-only",
    "security-review": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "loop": "user-invocable-only",
    "artifact-design": "name-only",
    "artifact-diagramming": "name-only",
    "workflow-authoring": "name-only",
    "dataviz": "name-only",
    "claude-api": "name-only",
    "frontend-design:frontend-design": "name-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/cmd hook claude pre-tool-use 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "mcp__t3-code__delegate_task",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/cmd hook claude pre-tool-use 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/cmd hook claude pre-tool-use 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/cmd hook claude pre-tool-use 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "mcp__t3-code__watch_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/cmd hook claude pre-tool-use 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "notf -T bell,macos -t Claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/cmd hook claude post-tool-use 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/cmd hook claude session-start 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.local/bin/cmd statusline"
  },
  "enabledPlugins": {
    "github@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": false,
    "safety-net@cc-marketplace": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    }
  },
  "promptCacheTtl": "1h",
  "effortLevel": "high",
  "modelSettings": {
    "claude-haiku-5-5": {
      "autoCompactWindow": 256000
    },
    "claude-haiku-4-5": {
      "autoCompactWindow": 100000
    },
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 375000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 256000
    }
  },
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "switchModelsOnFlag": true,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754075865483
  }
}
